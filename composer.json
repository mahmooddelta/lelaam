{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.0.2",
        "alperenersoy/filament-export": "^0.1.0@alpha",
        "ashallendesign/short-url": "^7.0",
        "bezhansalleh/filament-google-analytics": "^0.0.2",
        "bezhansalleh/filament-shield": "^2.0",
        "cybercog/laravel-ban": "^4.7",
        "doctrine/dbal": "^3.3",
        "filament/filament": "^2.12",
        "filament/spatie-laravel-media-library-plugin": "^2.11",
        "flowframe/laravel-trend": "^0.1.1",
        "guzzlehttp/guzzle": "^7.2",
        "inertiajs/inertia-laravel": "^0.5.2",
        "jeffgreco13/filament-breezy": "^1.3",
        "kasraghoreyshi/persian-faker": "^1.04",
        "laravel/framework": "^9.19",
        "laravel/jetstream": "^2.7",
        "laravel/sanctum": "^2.14.1",
        "laravel/tinker": "^2.7",
        "maize-tech/laravel-markable": "^1.0",
        "orangehill/iseed": "^3.0",
        "php-open-source-saver/jwt-auth": "^1.4",
        "pishran/laravel-persian-slug": "^2.2",
        "psr/simple-cache": "1.0",
        "pusher/pusher-php-server": "^7.0",
        "ralphjsmit/laravel-filament-seo": "^1.0",
        "spatie/laravel-collection-macros": "^7.11",
        "spatie/laravel-medialibrary-pro": "2.*",
        "spatie/laravel-sluggable": "^3.4",
        "tightenco/ziggy": "^1.0"
    },
    "require-dev": {
        "barryvdh/laravel-ide-helper": "^2.12",
        "fakerphp/faker": "^1.9.1",
        "laravel/pint": "^1.0",
        "laravel/sail": "^1.0.1",
        "mockery/mockery": "^1.4.4",
        "nunomaduro/collision": "^6.1",
        "phpunit/phpunit": "^9.5.10",
        "spatie/laravel-ignition": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan filament:upgrade"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://satis.spatie.be"
        }
    ],
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
